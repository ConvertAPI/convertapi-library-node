{
  "name": "convertapi",
  "version": "0.0.0-local",
  "description": "Official convertapi.com API client",
  "main": "./lib/index.js",
  "types": "./index.d.ts",
  "scripts": {
    "clean": "rimraf lib",
    "test": "npm run lint && npm run cover",
    "test:prod": "cross-env BABEL_ENV=production npm run test",
    "test:only": "mocha --require babel-core/register --require babel-polyfill --recursive --timeout 15000",
    "test:watch": "npm test -- --watch",
    "test:examples": "node examples/",
    "cover": "c8 --reporter=text --reporter=lcov mocha --require babel-core/register --require babel-polyfill --recursive --timeout 15000",
    "lint": "eslint src test",
    "build": "cross-env BABEL_ENV=production babel src --out-dir lib",
    "prepublishOnly": "echo 'convertapi is published by a GitHub Release, see RELEASING.md' && exit 1"
  },
  "files": [
    "lib",
    "src",
    "index.d.ts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ConvertAPI/convertapi-library-node.git"
  },
  "keywords": [
    "convert",
    "api",
    "client",
    "sdk",
    "conversion",
    "convertapi",
    "files"
  ],
  "author": "Tomas Rutkauskas <support@convertapi.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ConvertAPI/convertapi-library-node/issues"
  },
  "homepage": "https://github.com/ConvertAPI/convertapi-library-node#readme",
  "dependencies": {
    "axios": "^1.20.0"
  },
  "devDependencies": {
    "babel-cli": "^6.26.0",
    "babel-eslint": "^10.1.0",
    "babel-plugin-add-module-exports": "^0.2.1",
    "babel-polyfill": "^6.26.0",
    "babel-preset-env": "^1.6.1",
    "babel-preset-minify": "^0.5.2",
    "c8": "^12.0.0",
    "chai": "^6.3.0",
    "chai-as-promised": "^8.0.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.13.0",
    "eslint-config-airbnb": "~19.0.4",
    "eslint-plugin-import": "^2.7.0",
    "eslint-plugin-jsx-a11y": "^6.0.2",
    "eslint-plugin-react": "^7.4.0",
    "mocha": "^12.0.3",
    "rimraf": "^2.6.2"
  }
}
